# Store
TRISYNAPSE_MEMORY_PATH=~/.trisynapse-memory/store
# Optional administrator token override; otherwise `init` creates <store>/.api-key.
TRISYNAPSE_MEMORY_API_KEY=

# Model choices are saved per store with `trisynapse-memory models set` or /model.
# Add only the keys used by those choices. Trisynapse does not automatically
# load this file and never persists these values. Never commit real credentials.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_TOKEN=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
