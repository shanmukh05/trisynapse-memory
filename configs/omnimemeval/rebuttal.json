        "retrieval_config": "locomo/raw-hybrid.json"
      }
    },
    {
      "name": "locomo-raw-hybrid-second-judge",
      "suite": "locomo",
      "priority": "robustness",
      "options": {
        "reuse": "locomo-raw-hybrid",
        "from_step": 4,
        "judge_model": "gpt-4.1-2025-04-14",
        "retrieval_config": "locomo/raw-hybrid.json"
      }
    },
    {
