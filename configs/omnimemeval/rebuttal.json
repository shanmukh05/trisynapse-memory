{
  "defaults": {
    "memory_model": "gpt-4.1-mini-2025-04-14",
    "embedding_model": "all-MiniLM-L6-v2",
    "answer_model": "gpt-4.1-mini-2025-04-14",
    "judge_model": "gpt-4o-mini-2024-07-18",
    "top_k": 20,
    "workers": 4,
    "llm_workers": 10,
    "num_runs": 1
  },
  "groups": {
    "first": ["locomo-full", "locomo-raw-hybrid"],
    "beam100k-halumem": ["beam100k-full", "halumem-qa"],
    "fast": [
      "locomo-full",
      "locomo-raw-hybrid",
      "personamem-pilot",
      "beam100k-full",
      "locomo-raw-bm25",
      "locomo-raw-dense",
      "locomo-no-graph",
      "locomo-no-claims",
      "locomo-no-summaries",
      "locomo-no-reranker",
      "locomo-no-rrf",
      "locomo-raw-readout",
      "locomo-ranked-readout"
    ],
    "robustness": [
      "locomo-full-repeat-2",
      "locomo-full-repeat-3",
      "locomo-full-second-judge",
      "locomo-raw-hybrid-repeat-2",
      "locomo-raw-hybrid-repeat-3",
      "locomo-raw-hybrid-second-judge"
    ],
    "sensitivity": [
      "locomo-gate-low",
      "locomo-gate-high",
      "locomo-rrf-low",
      "locomo-rrf-high",
      "locomo-topk-low",
      "locomo-topk-high"
    ],
    "locomo-personamem-full": [
      "locomo-full",
      "locomo-raw-hybrid",
      "locomo-raw-bm25",
      "locomo-raw-dense",
      "locomo-no-graph",
      "locomo-no-claims",
      "locomo-no-summaries",
      "locomo-no-reranker",
      "locomo-no-rrf",
      "locomo-raw-readout",
      "locomo-ranked-readout",
      "locomo-full-repeat-2",
      "locomo-full-repeat-3",
      "locomo-full-second-judge",
      "locomo-raw-hybrid-repeat-2",
      "locomo-raw-hybrid-repeat-3",
      "locomo-raw-hybrid-second-judge",
      "locomo-gate-low",
      "locomo-gate-high",
      "locomo-rrf-low",
      "locomo-rrf-high",
      "locomo-topk-low",
      "locomo-topk-high",
      "personamem-full"
    ]
  },
  "runs": [
    {
      "name": "locomo-ingest",
      "suite": "locomo",
      "priority": "first",
      "options": {
        "to_step": 1
      }
    },
    {
      "name": "locomo-full",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/full.json"
      }
    },
    {
      "name": "locomo-raw-hybrid",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/raw-hybrid.json"
      }
    },
    {
      "name": "locomo-memos",
      "suite": "locomo",
      "priority": "matched-baseline",
      "options": {
        "backend": "memos"
      }
    },
    {
      "name": "locomo-raw-bm25",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/raw-bm25.json"
      }
    },
    {
      "name": "locomo-raw-dense",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
