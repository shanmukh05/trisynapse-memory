        "retrieval_config": "locomo/raw-dense.json"
      }
    },
    {
      "name": "locomo-no-graph",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/no-graph.json"
      }
    },
    {
      "name": "locomo-no-claims",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/no-claims.json"
      }
    },
    {
      "name": "locomo-no-summaries",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/no-summaries.json"
      }
    },
    {
      "name": "locomo-no-reranker",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/no-reranker.json"
      }
    },
    {
      "name": "locomo-no-rrf",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/no-rrf.json"
      }
    },
    {
      "name": "locomo-raw-readout",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/raw-readout.json"
      }
    },
    {
      "name": "locomo-ranked-readout",
      "suite": "locomo",
      "priority": "ablation",
      "options": {
        "reuse": "locomo-ingest",
        "from_step": 2,
        "retrieval_config": "locomo/ranked-readout.json"
      }
    },
    {
      "name": "personamem-pilot",
      "suite": "personamem",
      "priority": "next-dataset",
      "options": {
        "last_unit": 15
      }
    },
    {
      "name": "personamem-memos-pilot",
      "suite": "personamem",
      "priority": "matched-baseline",
      "options": {
        "last_unit": 15,
        "backend": "memos"
      }
    },
    {
      "name": "beam100k-full",
      "suite": "beam100k",
      "priority": "next-dataset",
      "options": {}
    },
    {
      "name": "personamem-full",
      "suite": "personamem",
      "priority": "stretch",
      "options": {}
    },
    {
      "name": "personamem-memos-full",
      "suite": "personamem",
      "priority": "matched-baseline",
      "options": {
        "backend": "memos"
      }
    },
    {
